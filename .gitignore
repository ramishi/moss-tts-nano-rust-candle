# Build
/target/
/dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Model cache (downloaded at runtime, repo root only)
/models/
models_backup_*/

# Release staging: all model artifacts are git-ignored and uploaded to GitHub Releases instead.
# The binary downloads them (SHA256-verified) from the release at runtime.
# Only weights_manifest.json is committed (it is embedded into the binary for verification).
/release/moss_tts_nano_lm.safetensors
/release/moss_audio_tokenizer.safetensors
/release/tokenizer.model
/release/config.json
/release/moss_audio_tokenizer_config.json
/release/*.safetensors
/release/*.sha256
/release/*.data
/release/*.bin
/release/*.onnx
# NOTE: only weights_manifest.json is NOT ignored — it is committed and embedded in the binary.

# Python (not used, but just in case)
__pycache__/
*.pyc
.venv/

# Test artifacts
*.npy
test_output*.wav

# Debug exports
debug_export/

# Local audio samples (for manual quality review, not for publication)
audio_samples/

# WorkBuddy (local assistant data, not for publication)
.workbuddy/
announcement_posts.md
